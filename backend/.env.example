# ============================================================================
# V.I.S.I.O.N. Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in actual values for your deployment
# DO NOT commit actual secrets to version control
# ============================================================================

# ============================================================================
# GOOGLE CLOUD PLATFORM (Vertex AI / Gemini)
# ============================================================================
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=europe-west1

# AI Model Configuration
GEMINI_MODEL=gemini-2.5-flash

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Options: LOCAL, CLOUD
DATABASE_TARGET=LOCAL

# For CLOUD target, use PostgreSQL connection string
# DATABASE_URL=postgresql://user:password@host:5432/vision_db

# For LOCAL target (SQLite)
# DATABASE_URL=sqlite:///vision.db

# ============================================================================
# CONFLUENCE INTEGRATION
# ============================================================================
CONFLUENCE_URL=https://your-company.atlassian.net
CONFLUENCE_PAT=your-confluence-personal-access-token
CONFLUENCE_SPACES=SPACE1,SPACE2,SPACE3

# ============================================================================
# AZURE DEVOPS (ADO) INTEGRATION
# ============================================================================
ADO_URL=https://dev.azure.com/your-organization
ADO_PAT=your-azure-devops-personal-access-token
ADO_PROJECTS=PROJECT1,PROJECT2,PROJECT3
ADO_PROJECT=Genoa Kiosk
ADO_TIMEOUT=5
ADO_LOOKBACK_DAYS=180
ADO_INCLUDE_COMPLETED=false
ADO_ENABLE_INTENT_CLASSIFICATION=true
ADO_ENABLE_SCORING=true
ADO_RELEVANCE_THRESHOLD=50.0

# ============================================================================
# API RATE LIMITING
# ============================================================================
RATE_LIMIT_UPLOAD_WINDOW=60
RATE_LIMIT_UPLOAD_COUNT=5
RATE_LIMIT_SYNC_CONFLUENCE_PAGE=20/hour
RATE_LIMIT_SYNC_CONFLUENCE_DELTA=5/hour
RATE_LIMIT_SYNC_ADO_ITEM=20/hour
RATE_LIMIT_SYNC_ADO_DELTA=5/hour

# ============================================================================
# RAG (RETRIEVAL AUGMENTED GENERATION) CONFIGURATION
# ============================================================================
# Vector Search Thresholds
RAG_DISTANCE_THRESHOLD=0.60
RAG_HIGH_THRESHOLD=0.40
RAG_MARGIN_THRESHOLD=0.15
RAG_MIN_VIABLE_COUNT=2
RAG_MIN_CONSENSUS_COUNT=2
RAG_ALLOW_SINGLE_CHUNK_HIGH=true
RAG_SINGLE_CHUNK_HIGH_THRESHOLD=0.30
RAG_USE_NEW_EVALUATOR=true
RAG_TOP_K=3

# Text Processing
RAG_CHUNK_SIZE=1500
RAG_CHUNK_OVERLAP=300
RAG_MAX_CONTEXT_CHARS=30000
RAG_MAX_LINK_DEPTH=3

# Embedding Configuration
VERTEX_EMBEDDING_BATCH_SIZE=15

# ============================================================================
# UPLOAD & FILE HANDLING
# ============================================================================
MAX_UPLOAD_SIZE_MB=15
MAX_MESSAGE_LENGTH=50000
MAX_SESSION_TITLE_LENGTH=255
LOCAL_TEMP_UPLOAD_DIR=temp_docs
LOCAL_TEMP_AUDIO_DIR=temp_audio
LOCAL_DB_DIR=./data/chroma

# ============================================================================
# SESSION & CONVERSATION CONFIGURATION
# ============================================================================
DEFAULT_SESSION_ID=default_session
DEFAULT_SESSION_TITLE=Default Session
DEFAULT_CHAT_TITLE=General Session
MAX_CONTEXT_TURNS=10
UI_HISTORY_LIMIT=50

# ============================================================================
# SYNC CONFIGURATION
# ============================================================================
MIN_SYNC_INTERVAL_MINUTES=1
MAX_SYNC_INTERVAL_MINUTES=1440
DEFAULT_SYNC_INTERVAL_MINUTES=60

# ============================================================================
# HTTP & NETWORK CONFIGURATION
# ============================================================================
HTTP_TIMEOUT_SECONDS=10
HTTP_TIMEOUT_LONG_SECONDS=20

# ============================================================================
# CACHING & PERFORMANCE
# ============================================================================
MAX_SEMANTIC_CACHE_SIZE=500
MAX_LOG_ENTRIES=500

# ============================================================================
# DATABASE TARGET & CLOUD POSTGRES
# ============================================================================
# Options: LOCAL (SQLite + Chroma), CLOUD (PostgreSQL + pgvector)
DATABASE_TARGET=LOCAL

# PostgreSQL connection (only needed when DATABASE_TARGET=CLOUD)
# DATABASE_URL=postgresql://user:password@localhost:5432/vision_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vision_db
POSTGRES_USER=vision_user
POSTGRES_PASSWORD=your-secure-password

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FILE=logs/vision.log

# ============================================================================
# SECURITY & AUTHENTICATION
# ============================================================================
# JWT Secret for session tokens (generate a secure random string)
# JWT_SECRET=your-super-secret-key-change-this

# Session timeout in minutes
# SESSION_TIMEOUT_MINUTES=1440

# ============================================================================
# DEPLOYMENT ENVIRONMENT
# ============================================================================
# Options: development, staging, production
ENVIRONMENT=development

# CORS Origins (comma-separated)
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-domain.com

# ============================================================================
# CLOUD RUN / CONTAINER DEPLOYMENT
# ============================================================================
# Port to run on (default 8000)
# PORT=8000

# Number of worker processes
# WORKERS=4

# ============================================================================
# NOTES FOR DEVELOPERS
# ============================================================================
# 1. Generate Personal Access Tokens:
#    - Confluence: https://id.atlassian.com/manage-profile/security/api-tokens
#    - Azure DevOps: https://dev.azure.com/_usersSettings/tokens
#
# 2. GCP Project Setup:
#    - Create project in Google Cloud Console
#    - Enable Vertex AI API
#    - Set up Application Default Credentials (gcloud auth application-default login)
#
# 3. Local vs Cloud Database:
#    - LOCAL: Uses SQLite (development/testing)
#    - CLOUD: Uses PostgreSQL (production)
#
# 4. Rate Limiting Format:
#    - "20/hour" = 20 requests per hour
#    - "5/minute" = 5 requests per minute
#
# 5. Security Best Practices:
#    - Never commit actual .env file to git
#    - Use .env in .gitignore
#    - Rotate PATs regularly
#    - Use strong JWT secrets in production
#    - Keep LOG_LEVEL=WARNING or higher in production
#
# 6. Testing Configuration:
#    - Use LOCAL database for development
#    - Set LOG_LEVEL=DEBUG for troubleshooting
#    - Use test Confluence/ADO spaces
#
# ============================================================================
