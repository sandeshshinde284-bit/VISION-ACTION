# ============================================================================
# V.I.S.I.O.N. Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control (it contains secrets)

# Google Cloud Platform Settings
GCP_PROJECT_ID="gbr-mts-wgh-hkt-dev"
GCP_LOCATION="europe-west1"

# Gemini Model Configuration
GEMINI_MODEL="gemini-2.5-flash"

# Database Configuration
DATABASE_TARGET="LOCAL"  # Options: LOCAL (SQLite) or CLOUD (PostgreSQL)

# PostgreSQL Cloud Configuration (if DATABASE_TARGET=CLOUD)
PG_HOST="127.0.0.1"
PG_PORT="5432"
PG_DATABASE="vision_db"
PG_USER="postgres"
PG_PASSWORD=""

# Confluence Integration
CONFLUENCE_URL=""
CONFLUENCE_PAT=""
CONFLUENCE_SPACES="ERK"

# Azure DevOps Integration
ADO_URL=""
ADO_PAT=""
ADO_PROJECT="Genoa Kiosk"

# RAG & Embedding Configuration
RAG_DISTANCE_THRESHOLD="0.60"
RAG_HIGH_THRESHOLD="0.40"
RAG_MARGIN_THRESHOLD="0.15"
RAG_TOP_K="3"
MAX_UPLOAD_SIZE_MB="15"

# Session & Authentication Configuration
SESSION_TIMEOUT_HOURS="24"
SESSION_TOKEN_LENGTH="32"

# Default Admin User (Created on first database initialization)
DEFAULT_ADMIN_USERNAME="sandesh"
DEFAULT_ADMIN_PASSWORD="vision@sandesh"

# Local Storage Paths
LOCAL_DB_DIR="C:/Users/w114216/.gemini/tmp/vision/data/chroma"
LOCAL_TEMP_UPLOAD_DIR="C:/Users/w114216/.gemini/tmp/vision/temp_docs"
